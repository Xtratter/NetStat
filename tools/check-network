#!/usr/bin/env bash
set -eu
cd "$(dirname "$0")/.."
# Ask the Termux network stack which source address it would use, including per-app VPN routing.
local_ip=$(python -c 'import socket; s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.connect(("1.1.1.1", 53)); print(s.getsockname()[0])')
addresses=$(su -c '/system/bin/ip -o -4 addr show')
interfaces=$(printf '%s\n' "$addresses" | awk -v addr="$local_ip" '$3 == "inet" {split($4, a, "/"); if (a[1] == addr) {split($2, n, "@"); print n[1]}}' | sort -u)
if [[ -z "$interfaces" || "$interfaces" == *$'\n'* ]]; then
    echo "Не удалось однозначно определить интерфейс для адреса Termux $local_ip." >&2
    exit 1
fi
exec python tools/pcapd_bench.py dns --interface "$interfaces" --local-ip "$local_ip" \
    --pcapd .superpowers/pcapd-bin/dist/arm64-v8a/libpcapd.so \
    --output ".superpowers/check-net-$(date +%s)-$$"
